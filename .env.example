# === LLM Provider ===
# Provider: "gemini" (default) or "grok"
LLM_PROVIDER=gemini

# Google Gemini (default)
GOOGLE_API_KEY=

# xAI Grok (alternative)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.20

# === Database ===
POCKETBASE_URL=http://127.0.0.1:8090

# === API Auth (optional) ===
# If set, all API endpoints require: Authorization: Bearer <FRICTIONLOG_API_KEY>
FRICTIONLOG_API_KEY=

# === API URL (for CLI / Dashboard) ===
API_URL=http://127.0.0.1:8000
